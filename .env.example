# Copy to .env and fill in. Never commit .env (gitignored).
# Required: get one at https://aistudio.google.com (free tier is enough).
GEMINI_API_KEY=changeme

# Optional overrides (defaults work for local/podman/k8s).
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_JUDGE_MODEL=gemini-3.6-flash
# GEMINI_JUDGE_FALLBACK=gemini-2.5-flash
# YT_SHORTER_WHISPER_MODEL=base
# YT_SHORTER_COOKIES=/data/cookies.txt

# --- Proveedores LLM alternativos (opt-in, P5.1) -----------------------------
# Gemini sigue siendo el default y el respaldo: sin estas claves no cambia nada.
# API OpenAI-compatible; la cadena cae al siguiente proveedor ante cuota/caída.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b   # solo juez (máx 3 frames)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
# YT_SHORTER_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
# YT_SHORTER_LOCAL_MODEL=local-model
# YT_SHORTER_LOCAL_API_KEY=
# YT_SHORTER_LLM_ORDER=groq,gemini
